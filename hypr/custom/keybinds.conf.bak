# See https://wiki.hyprland.org/Configuring/Binds/
#!
##! Apps

# 1. Apps
unbind = Super, Super_L
unbind = Super, Super_R
bind = Super, Super_L, exec, qs -c noctalia-shell ipc call launcher toggle #"Launcher"
bind = Super, Super_R, exec, qs -c noctalia-shell ipc call launcher toggle #"Launcher"
unbind = Super, W
bind = Super, W, exec, firefox #"Browser"
unbind = Super, M
bind = Super, M, exec, geary #"Mail"
unbind = Super, Y
bind = Super, Y, exec, chromium --app=https://youtube.com --class=youtube-app #"YouTube"
unbind = Super+Alt, Y
bind = Super+Alt, Y, exec, chromium --app=https://music.youtube.com --class=youtube-music-app #"YouTube Music"
unbind = Super+Shift, Y
bind = Super+Shift, Y, exec, spotify #"Spotify"
bind = Super+Shift+Alt, Y, exec, spotify #"Spotify (alt)"
bind = Super+Shift, G, exec, kitty -e ~/.local/bin/egpu-detect.sh #"Detect eGPU"
bindd = Super, Slash, Toggle cheatsheet, exec, qs -c noctalia-shell ipc call plugin:keybind-cheatsheet toggle #"Cheatsheet"

# 2. User
bind = Ctrl+Super, Slash, exec, xdg-open ~/.config/illogical-impulse/config.json #"Edit shell config"
bind = Ctrl+Super+Alt, Slash, exec, xdg-open ~/.config/hypr/custom/keybinds.conf #"Edit extra keybinds"
unbind = Super+Shift, M
bindd = Super+Shift, M, Toggle media controls, exec, qs -c noctalia-shell ipc call media toggle #"Media controls"
